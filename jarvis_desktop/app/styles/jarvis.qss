/* jarvis_desktop/app/styles/jarvis.qss */
/* Sci-Fi HUD aesthetic — cyan primary accent, deep navy background, purple CTA accent */

/* Overall Window & Root Background */
QMainWindow, QWidget#rootWindow {
    background-color: #050510;
    color: #ffffff;
    font-family: 'Poppins', 'Segoe UI', sans-serif;
}

/* Glassmorphism Panel Styling */
.GlassPanel, QFrame#glassPanel {
    background-color: rgba(10, 14, 30, 0.75);
    border: 1px solid rgba(0, 217, 255, 0.10);
    border-radius: 16px;
}

/* Top Header Bar — cyan bottom accent line */
QFrame#headerBar {
    background-color: rgba(8, 12, 28, 0.92);
    border-bottom: 1px solid rgba(0, 217, 255, 0.22);
    border-radius: 0px;
}

QLabel#logoLabel {
    font-size: 20px;
    font-weight: 700;
    color: #00D9FF;
    letter-spacing: 2px;
}

QLabel#taglineLabel {
    font-size: 11px;
    color: rgba(0, 217, 255, 0.35);
    letter-spacing: 0.5px;
}

/* Mode Switcher Container & Buttons */
QFrame#modeSwitcher {
    background-color: rgba(5, 5, 18, 0.90);
    border: 1px solid rgba(0, 217, 255, 0.12);
    border-radius: 12px;
    padding: 3px;
}

QPushButton.modeBtn {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: none;
    border-radius: 9px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.modeBtn:hover {
    color: #00D9FF;
    background-color: rgba(0, 217, 255, 0.07);
}

QPushButton.modeBtn[active="true"] {
    background-color: #7c6aef;
    color: #ffffff;
    font-weight: 600;
}

/* Status Badge */
QFrame#statusBadge {
    background-color: rgba(0, 217, 255, 0.04);
    border: 1px solid rgba(0, 217, 255, 0.14);
    border-radius: 14px;
    padding: 4px 10px;
}

QLabel#statusText {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
}

/* Icon Buttons Header */
QPushButton.headerIconBtn {
    background-color: rgba(0, 217, 255, 0.04);
    border: 1px solid rgba(0, 217, 255, 0.10);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.80);
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    font-size: 15px;
}

QPushButton.headerIconBtn:hover {
    background-color: rgba(0, 217, 255, 0.10);
    border-color: rgba(0, 217, 255, 0.40);
    color: #00D9FF;
}

/* Activity Sidebar Panel */
QFrame#sidebarPanel {
    background-color: rgba(8, 12, 28, 0.92);
    border-right: 1px solid rgba(0, 217, 255, 0.10);
    border-radius: 0px;
}

QLabel#sidebarTitle {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
}

/* Timeline Flow Card */
QFrame.timelineCard {
    background-color: rgba(10, 22, 40, 0.75);
    border: 1px solid rgba(0, 217, 255, 0.08);
    border-radius: 12px;
    padding: 10px;
}

QLabel.stepBadge {
    background-color: rgba(0, 217, 255, 0.08);
    color: #00D9FF;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 700;
}

/* Command Center Grid — cyan border-bottom accent */
QFrame#commandCenterCard {
    background-color: rgba(8, 12, 30, 0.78);
    border: 1px solid rgba(0, 217, 255, 0.18);
    border-bottom: 2px solid rgba(0, 217, 255, 0.32);
    border-radius: 16px;
    padding: 16px;
}

QLabel#commandCenterHeader {
    font-size: 11px;
    font-weight: 700;
    color: #00D9FF;
    letter-spacing: 1.5px;
}

QPushButton.cmdBtn {
    background-color: rgba(0, 217, 255, 0.03);
    border: 1px solid rgba(0, 217, 255, 0.10);
    border-radius: 10px;
    color: #ffffff;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
}

QPushButton.cmdBtn:hover {
    background-color: rgba(0, 217, 255, 0.10);
    border-color: #00D9FF;
    color: #00D9FF;
}

/* Metric Card (Today's Usage) — cyan border-bottom accent */
QFrame#metricCard {
    background-color: rgba(8, 14, 32, 0.78);
    border: 1px solid rgba(0, 217, 255, 0.12);
    border-bottom: 2px solid rgba(0, 217, 255, 0.25);
    border-radius: 16px;
    padding: 14px;
}

/* Chat Input Bar */
QFrame#inputBar {
    background-color: rgba(8, 12, 28, 0.90);
    border: 1px solid rgba(0, 217, 255, 0.12);
    border-radius: 20px;
    padding: 8px 14px;
}

QFrame#inputBar:focus-within {
    border-color: rgba(0, 217, 255, 0.40);
}

QTextEdit#messageInput {
    background-color: transparent;
    border: none;
    color: #ffffff;
    font-size: 14px;
    selection-background-color: #7c6aef;
}

QPushButton.inputActionBtn {
    background-color: rgba(0, 217, 255, 0.05);
    border: 1px solid rgba(0, 217, 255, 0.10);
    border-radius: 18px;
    color: rgba(255, 255, 255, 0.85);
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    font-size: 16px;
}

QPushButton.inputActionBtn:hover {
    background-color: rgba(0, 217, 255, 0.14);
    border-color: #00D9FF;
    color: #00D9FF;
}

/* Send button stays purple — clear CTA hierarchy */
QPushButton#sendBtn {
    background-color: #7c6aef;
    border: none;
    border-radius: 18px;
    color: #ffffff;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    font-size: 16px;
}

QPushButton#sendBtn:hover {
    background-color: #6956e6;
}

/* Scrollbars — cyan glow on hover */
QScrollBar:vertical {
    border: none;
    background: rgba(0, 0, 0, 0.15);
    width: 5px;
    border-radius: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(0, 217, 255, 0.18);
    border-radius: 2px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #00D9FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Dialog / Overlay Settings */
QDialog#settingsDialog {
    background-color: rgba(8, 12, 28, 0.96);
    border: 1px solid rgba(0, 217, 255, 0.22);
    border-radius: 20px;
}
